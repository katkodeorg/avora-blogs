---
import { BRAND_NAME, STORE_URL, CONTACT_EMAIL, SOCIAL_LINKS, withBase } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="top">
			<div class="wordmark">Avora</div>
			<p class="tag">Experience the eternal high.</p>
		</div>
		<nav class="links" aria-label="Footer">
			<a href={withBase('/')}>Home</a>
			<a href={withBase('/blog')}>Journal</a>
			<a href={withBase('/about')}>About</a>
			<a href={withBase('/faq')}>FAQ</a>
			<a href={STORE_URL} target="_blank" rel="noopener">Shop</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			{
				SOCIAL_LINKS.map((href) => (
					<a href={href} target="_blank" rel="noopener">
						{new URL(href).hostname.replace('www.', '')}
					</a>
				))
			}
		</nav>
		<p class="legal">
			&copy; {today.getFullYear()} {BRAND_NAME}. Ceremonial-grade matcha from
			first-harvest leaves in Kyoto &amp; Kagoshima, Japan.
		</p>
	</div>
</footer>
<style>
	footer {
		margin-top: 5rem;
		background: var(--color-crimson);
		color: color-mix(in srgb, var(--color-cream) 82%, transparent);
	}
	.inner {
		max-width: 1120px;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 3rem;
		text-align: center;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 2.6rem;
		font-weight: 600;
		color: var(--color-cream);
		line-height: 1;
	}
	.tag {
		font-style: italic;
		font-family: var(--font-display);
		margin: 0.4rem 0 0;
		color: color-mix(in srgb, var(--color-cream) 70%, transparent);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem 1.6rem;
		margin: 2rem 0 1.5rem;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.links a {
		color: color-mix(in srgb, var(--color-cream) 82%, transparent);
		text-decoration: none;
		text-transform: none;
	}
	.links a:hover {
		color: var(--color-cream);
	}
	.legal {
		font-size: 0.8rem;
		color: color-mix(in srgb, var(--color-cream) 60%, transparent);
		max-width: 40rem;
		margin: 0 auto;
	}
</style>
