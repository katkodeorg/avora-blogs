---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhiskTimer from '../components/WhiskTimer.tsx';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, STORE_URL, withBase } from '../consts';
import heroImg from '../assets/brand/hero-bg.jpg';
import regionImg from '../assets/brand/region.png';
import gradeImg from '../assets/brand/grade.jpg';
import tastingImg from '../assets/brand/tasting.png';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const cards = [
	{ img: regionImg, title: 'Region', text: 'First-harvest leaves sourced from Kyoto and Kagoshima, Japan.' },
	{ img: gradeImg, title: 'Grade', text: 'Ceremonial-grade, crafted from carefully selected leaves for a smooth, refined cup.' },
	{ img: tastingImg, title: 'Tasting Notes', text: 'Vibrant green, rich umami, fresh aroma. Full-bodied, calm, and gently energizing.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="hero">
				<div class="hero-copy">
					<span class="eyebrow animate-fade-up">The Avora Journal</span>
					<h1 class="animate-fade-up delay-1">
						The art of<br /><em>ceremonial</em> matcha
					</h1>
					<p class="lede animate-fade-up delay-2">
						Everything about ceremonial-grade matcha: how to make it, where it
						comes from, and why it feels the way it does. Not your stereotype of
						matcha.
					</p>
					<div class="cta-row animate-fade-up delay-3">
						<a class="btn primary" href={withBase('/blog')}>Read the Journal</a>
						<a class="btn outline" href={STORE_URL} target="_blank" rel="noopener">Shop Avora</a>
					</div>
				</div>
				<div class="hero-media animate-fade-up delay-2">
					<Image src={heroImg} alt="Avora ceremonial matcha in signature red tins" widths={[420, 720, 900]} sizes="(max-width: 860px) 90vw, 460px" />
				</div>
			</section>

			<!-- INTRO -->
			<section class="intro" data-reveal>
				<span class="rule"></span>
				<h2>Not your stereotypical matcha</h2>
				<p>
					Coffee is for hustle. Tea is for calm. Matcha never fit either. Real
					matcha is a paradox — calming yet energizing, grounding yet
					sharpening. It doesn't spike. It doesn't crash. It stays with you.
				</p>
			</section>

			<!-- CARDS -->
			<section class="cards">
				{
					cards.map((c, i) => (
						<article class="card lift" data-reveal data-reveal-delay={i * 120}>
							<div class="card-img">
								<Image src={c.img} alt={c.title} width={420} height={320} />
							</div>
							<h3>{c.title}</h3>
							<p>{c.text}</p>
						</article>
					))
				}
			</section>

			<!-- WHISK WIDGET -->
			<section class="widget" data-reveal>
				<div class="widget-copy">
					<span class="eyebrow">Try it</span>
					<h2>The 30-second whisk</h2>
					<p>
						The difference between grassy and smooth is often just technique.
						Use this timer next time you whisk: brisk “W” strokes for 30
						seconds.
					</p>
				</div>
				<div class="widget-tool">
					<WhiskTimer client:visible />
				</div>
			</section>

			<!-- LATEST POSTS -->
			<section class="latest" data-reveal>
				<div class="section-head">
					<h2>From the Journal</h2>
					<a class="viewall" href={withBase('/blog')}>View all →</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={withBase(`/blog/${post.id}/`)}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="post-title">{post.data.title}</span>
									<span class="post-desc">{post.data.description}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<style>
			main {
				max-width: 1120px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}
			.eyebrow {
				display: inline-block;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--color-crimson);
				margin-bottom: 0.9rem;
			}

			/* HERO */
			.hero {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				gap: 3rem;
				align-items: center;
				padding: 4.5rem 0 4rem;
			}
			.hero h1 {
				font-size: clamp(2.8rem, 6vw, 4.6rem);
				margin: 0 0 1.2rem;
			}
			.hero h1 em {
				font-style: italic;
				color: var(--color-crimson);
			}
			.lede {
				font-size: 1.2rem;
				color: var(--color-muted);
				max-width: 34ch;
				margin: 0 0 2rem;
			}
			.cta-row {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
			}
			.btn {
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				padding: 0.8rem 1.6rem;
				border-radius: 999px;
				transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
			}
			.btn.primary {
				background: var(--color-crimson);
				color: var(--color-cream);
				border: 2px solid var(--color-crimson);
			}
			.btn.primary:hover {
				background: var(--color-crimson-dark);
				border-color: var(--color-crimson-dark);
				transform: translateY(-2px);
			}
			.btn.outline {
				border: 2px solid var(--color-crimson);
				color: var(--color-crimson);
			}
			.btn.outline:hover {
				background: var(--color-crimson);
				color: var(--color-cream);
				transform: translateY(-2px);
			}
			.hero-media :global(img) {
				width: 100%;
				height: auto;
				border-radius: 20px;
				box-shadow: var(--shadow-lift);
			}

			/* INTRO */
			.intro {
				text-align: center;
				max-width: 620px;
				margin: 2rem auto 4.5rem;
			}
			.intro .rule {
				display: block;
				width: 48px;
				height: 3px;
				background: var(--color-crimson);
				margin: 0 auto 1.6rem;
				border-radius: 2px;
			}
			.intro p {
				font-size: 1.2rem;
				color: var(--color-body);
			}

			/* CARDS */
			.cards {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.75rem;
				margin-bottom: 5.5rem;
			}
			.card {
				background: var(--color-card);
				border: 1px solid var(--color-line);
				border-radius: var(--radius-card);
				padding: 1rem 1rem 1.6rem;
				box-shadow: var(--shadow-soft);
			}
			.card-img {
				overflow: hidden;
				border-radius: 12px;
				margin-bottom: 1.1rem;
			}
			.card-img :global(img) {
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				display: block;
				transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
			}
			.card:hover .card-img :global(img) {
				transform: scale(1.05);
			}
			.card h3 {
				margin: 0 0 0.4rem;
				padding: 0 0.4rem;
			}
			.card p {
				margin: 0;
				padding: 0 0.4rem;
				color: var(--color-muted);
				font-size: 1rem;
			}

			/* WIDGET */
			.widget {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
				gap: 3rem;
				align-items: center;
				background: var(--color-cream-soft);
				border: 1px solid var(--color-line);
				border-radius: 24px;
				padding: 3rem;
				margin-bottom: 5.5rem;
			}
			.widget-copy,
			.widget-tool {
				min-width: 0;
			}
			.widget h2 {
				margin: 0 0 0.8rem;
			}
			.widget p {
				color: var(--color-muted);
				margin: 0;
			}

			/* LATEST */
			.latest {
				margin-bottom: 2rem;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				border-bottom: 2px solid var(--color-ink);
				padding-bottom: 0.8rem;
				margin-bottom: 0.5rem;
			}
			.section-head h2 {
				margin: 0;
			}
			.viewall {
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				text-decoration: none;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				border-bottom: 1px solid var(--color-line);
			}
			.post-list a {
				display: grid;
				grid-template-columns: 160px 1fr;
				gap: 0.4rem 2rem;
				padding: 1.5rem 0.5rem;
				text-decoration: none;
				color: inherit;
				transition: padding 0.25s ease, background 0.25s ease;
			}
			.post-list a:hover {
				background: var(--color-cream-soft);
				padding-left: 1.2rem;
			}
			.post-date {
				grid-row: 1 / 3;
				font-size: 0.8rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-muted);
				padding-top: 0.35rem;
			}
			.post-title {
				font-family: var(--font-display);
				font-size: 1.5rem;
				font-weight: 600;
				color: var(--color-ink);
				line-height: 1.15;
			}
			.post-desc {
				color: var(--color-muted);
				font-size: 1rem;
			}

			@media (max-width: 860px) {
				.hero,
				.widget {
					grid-template-columns: 1fr;
				}
				.hero {
					padding: 3rem 0;
				}
				.hero-media {
					order: -1;
				}
				.cards {
					grid-template-columns: 1fr;
				}
				.widget {
					padding: 2rem;
				}
				.post-list a {
					grid-template-columns: 1fr;
					gap: 0.3rem;
				}
				.post-date {
					grid-row: auto;
				}
			}
		</style>
	</body>
</html>
